#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="${SERVERPAL_REPO:-778777266/ServerPal}"
CONFIG_FILE="${SERVERPAL_CONFIG:-/etc/serverpal/config.json}"
RELEASE_BASE="${SERVERPAL_RELEASE_BASE:-https://github.com/${REPOSITORY}/releases/latest/download}"
INSTALL_ROOT="/opt/serverpal"
DATA_ROOT="/var/lib/serverpal"
PROJECT_ROOT="/srv/serverpal/apps"
LOCK_FILE="/run/serverpal-maintenance.lock"

log() { printf '[ServerPal update] %s\n' "$*"; }
fail() { printf '[ServerPal update] ERROR: %s\n' "$*" >&2; exit 1; }
atomic_symlink() {
  local target="$1" link="$2" temporary="${2}.new.$$"
  ln -sfn "${target}" "${temporary}"
  mv -Tf "${temporary}" "${link}"
}

[[ "${EUID}" -eq 0 ]] || fail "run this command with sudo"
command -v flock >/dev/null 2>&1 || fail "flock is required"
if [[ "${SERVERPAL_LOCK_HELD:-0}" != "1" ]]; then
  exec 9>"${LOCK_FILE}"
  flock -n 9 || fail "another ServerPal update is already running"
fi
umask 0027

case "$(uname -m)" in
  x86_64) ARCH="amd64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *) fail "unsupported architecture: $(uname -m)" ;;
esac

ASSET="serverpal-linux-${ARCH}.tar.gz"
WORK_DIR="$(mktemp -d /tmp/serverpal-update.XXXXXX)"
trap 'rm -rf "${WORK_DIR}"' EXIT

log "downloading ${ASSET}"
curl --proto '=https' --tlsv1.2 -fsSLo "${WORK_DIR}/${ASSET}" "${RELEASE_BASE}/${ASSET}"
curl --proto '=https' --tlsv1.2 -fsSLo "${WORK_DIR}/checksums.txt" "${RELEASE_BASE}/checksums.txt"
CHECKSUM_LINE="$(awk -v file="${ASSET}" '$2 == file { print; exit }' "${WORK_DIR}/checksums.txt")"
[[ -n "${CHECKSUM_LINE}" ]] || fail "release checksum is missing"
(cd "${WORK_DIR}" && printf '%s\n' "${CHECKSUM_LINE}" | sha256sum -c -)
mkdir -p "${WORK_DIR}/release"
tar -xzf "${WORK_DIR}/${ASSET}" -C "${WORK_DIR}/release"
[[ -x "${WORK_DIR}/release/serverpal" ]] || fail "release does not contain the ServerPal binary"

NEW_VERSION="$("${WORK_DIR}/release/serverpal" version | awk 'NR==1 {print $2}')"
[[ "${NEW_VERSION}" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$ ]] || fail "release version is invalid"
CURRENT_VERSION="none"
if [[ -x "${INSTALL_ROOT}/current/serverpal" ]]; then
  CURRENT_VERSION="$("${INSTALL_ROOT}/current/serverpal" version | awk 'NR==1 {print $2}')"
fi
if [[ "${CURRENT_VERSION}" != "none" && "${NEW_VERSION}" != "${CURRENT_VERSION}" ]] && \
   dpkg --compare-versions "${NEW_VERSION#v}" lt "${CURRENT_VERSION#v}" && \
   [[ "${SERVERPAL_ALLOW_DOWNGRADE:-0}" != "1" ]]; then
  fail "refusing downgrade ${CURRENT_VERSION} -> ${NEW_VERSION}; set SERVERPAL_ALLOW_DOWNGRADE=1 to override"
fi

APP_GROUP_REMOVED=0
if id serverpal-app >/dev/null 2>&1 && id -nG serverpal-app | tr ' ' '\n' | grep -Fxq serverpal; then
  log "removing project user from the control-plane group"
  gpasswd -d serverpal-app serverpal >/dev/null
  APP_GROUP_REMOVED=1
fi
install -d -o serverpal -g serverpal -m 0751 "${DATA_ROOT}"
install -d -o serverpal -g serverpal -m 0750 "${DATA_ROOT}/backups"
install -d -o serverpal-app -g serverpal-app -m 0750 "${DATA_ROOT}/app-home" "${DATA_ROOT}/pm2"
install -d -o serverpal-app -g serverpal-app -m 0750 "${PROJECT_ROOT}"
if [[ -d "${INSTALL_ROOT}/node" ]]; then
  chown -R root:root "${INSTALL_ROOT}/node"
  chmod -R u=rwX,go=rX "${INSTALL_ROOT}/node"
fi
if [[ -d "${INSTALL_ROOT}/pm2-runtime" ]]; then
  chown -R root:root "${INSTALL_ROOT}/pm2-runtime"
  chmod -R u=rwX,go=rX "${INSTALL_ROOT}/pm2-runtime"
fi
chown root:serverpal /etc/serverpal/config.json /etc/serverpal/agent.token
chmod 0640 /etc/serverpal/config.json /etc/serverpal/agent.token

if [[ "${NEW_VERSION}" == "${CURRENT_VERSION}" ]]; then
  HEALTH_RESPONSE="$(curl -fsS --max-time 4 "http://127.0.0.1:8787/api/health" 2>/dev/null || true)"
  if [[ "${HEALTH_RESPONSE}" == *'"agent":"ok"'* && "${HEALTH_RESPONSE}" == *"\"version\":\"${NEW_VERSION}\""* ]]; then
    if [[ "${APP_GROUP_REMOVED}" -eq 0 ]]; then
      log "${NEW_VERSION} is already installed and healthy"
      exit 0
    fi
    log "${NEW_VERSION} is healthy but requires a project-user security repair"
  else
    log "${NEW_VERSION} is installed but unhealthy; repairing from the release archive"
  fi
fi

PREVIOUS_RELEASE="$(readlink -f "${INSTALL_ROOT}/current" 2>/dev/null || true)"
NEW_RELEASE="${INSTALL_ROOT}/releases/${NEW_VERSION}"
BACKUP_DIR="${DATA_ROOT}/backups/update-$(date -u +%Y%m%dT%H%M%SZ)-${CURRENT_VERSION}"
install -d -o root -g root -m 0755 "${INSTALL_ROOT}" "${INSTALL_ROOT}/releases" "${NEW_RELEASE}"
install -d -o serverpal -g serverpal -m 0750 "${BACKUP_DIR}"
cp -a "${CONFIG_FILE}" "${BACKUP_DIR}/config.json"
if [[ -x "${INSTALL_ROOT}/current/serverpal" ]]; then
  cp -a "${INSTALL_ROOT}/current/serverpal" "${BACKUP_DIR}/serverpal"
fi
for unit in serverpal-agent.service serverpal-web.service serverpal-pm2.service; do
  if [[ -f "/etc/systemd/system/${unit}" ]]; then cp -a "/etc/systemd/system/${unit}" "${BACKUP_DIR}/${unit}"; fi
done

log "backing up the control-plane database"
if [[ -f "${DATA_ROOT}/serverpal.db" ]]; then
  runuser -u serverpal -- sqlite3 "${DATA_ROOT}/serverpal.db" "PRAGMA wal_checkpoint(TRUNCATE);"
  runuser -u serverpal -- sqlite3 "${DATA_ROOT}/serverpal.db" ".backup '${BACKUP_DIR}/serverpal.db'"
  chmod 0640 "${BACKUP_DIR}/serverpal.db"
fi

ROLLBACK_READY=1
rollback() {
  local reason="$1"
  trap - ERR
  set +e
  log "update failed: ${reason}; rolling back"
  systemctl stop serverpal-web.service serverpal-agent.service || true
  if [[ "${PREVIOUS_RELEASE}" == "${NEW_RELEASE}" && -f "${BACKUP_DIR}/serverpal" ]]; then
    install -m 0755 "${BACKUP_DIR}/serverpal" "${NEW_RELEASE}/serverpal.rollback"
    mv -f "${NEW_RELEASE}/serverpal.rollback" "${NEW_RELEASE}/serverpal"
  fi
  if [[ -n "${PREVIOUS_RELEASE}" && -d "${PREVIOUS_RELEASE}" ]]; then
    atomic_symlink "${PREVIOUS_RELEASE}" "${INSTALL_ROOT}/current"
  fi
  if [[ -f "${BACKUP_DIR}/serverpal.db" ]]; then
    find "${DATA_ROOT}" -maxdepth 1 -type f -name 'serverpal.db-*' -delete
    install -o serverpal -g serverpal -m 0640 "${BACKUP_DIR}/serverpal.db" "${DATA_ROOT}/serverpal.db"
  fi
  if [[ -f "${BACKUP_DIR}/config.json" ]]; then
    install -o root -g serverpal -m 0640 "${BACKUP_DIR}/config.json" "${CONFIG_FILE}"
  fi
  for unit in serverpal-agent.service serverpal-web.service serverpal-pm2.service; do
    if [[ -f "${BACKUP_DIR}/${unit}" ]]; then install -m 0644 "${BACKUP_DIR}/${unit}" "/etc/systemd/system/${unit}"; fi
  done
  systemctl daemon-reload
  if [[ "${APP_GROUP_REMOVED}" -eq 1 ]]; then systemctl restart serverpal-pm2.service || true; fi
  systemctl start serverpal-agent.service serverpal-web.service
  printf '[ServerPal update] ERROR: update rolled back to %s; backup: %s\n' "${CURRENT_VERSION}" "${BACKUP_DIR}" >&2
  exit 1
}

handle_error() {
  local exit_code="$1"
  local line="$2"
  trap - ERR
  if [[ "${ROLLBACK_READY:-0}" -eq 1 ]]; then
    rollback "command failed at line ${line} (exit ${exit_code})"
  fi
  exit "${exit_code}"
}
trap 'handle_error "$?" "$LINENO"' ERR

systemctl stop serverpal-web.service
install -m 0755 "${WORK_DIR}/release/serverpal" "${NEW_RELEASE}/serverpal.new"
mv -f "${NEW_RELEASE}/serverpal.new" "${NEW_RELEASE}/serverpal"

log "applying database migrations"
if ! runuser -u serverpal -- "${NEW_RELEASE}/serverpal" migrate --config "${CONFIG_FILE}"; then
  rollback "database migration failed"
fi
atomic_symlink "${NEW_RELEASE}" "${INSTALL_ROOT}/current"
if [[ -d "${WORK_DIR}/release/systemd" ]]; then
  install -m 0644 "${WORK_DIR}/release/systemd/serverpal-agent.service" /etc/systemd/system/serverpal-agent.service
  install -m 0644 "${WORK_DIR}/release/systemd/serverpal-web.service" /etc/systemd/system/serverpal-web.service
  install -m 0644 "${WORK_DIR}/release/systemd/serverpal-pm2.service" /etc/systemd/system/serverpal-pm2.service
  systemctl daemon-reload
fi
if [[ "${APP_GROUP_REMOVED}" -eq 1 ]]; then
  log "restarting PM2 once to apply the corrected project-user groups"
  systemctl restart serverpal-pm2.service
fi
systemctl restart serverpal-agent.service
systemctl start serverpal-web.service

HEALTHY=0
for _ in $(seq 1 30); do
  HEALTH_RESPONSE="$(curl -fsS --max-time 4 "http://127.0.0.1:8787/api/health" 2>/dev/null || true)"
  if [[ "${HEALTH_RESPONSE}" == *'"agent":"ok"'* && "${HEALTH_RESPONSE}" == *"\"version\":\"${NEW_VERSION}\""* ]]; then
    HEALTHY=1
    break
  fi
  sleep 1
done
[[ "${HEALTHY}" -eq 1 ]] || rollback "the new control plane did not become healthy"

ROLLBACK_READY=0
if [[ -f "${WORK_DIR}/release/serverpal-update" ]]; then
  install -m 0755 "${WORK_DIR}/release/serverpal-update" /usr/local/sbin/serverpal-update
fi
log "updated ${CURRENT_VERSION} -> ${NEW_VERSION}; backup: ${BACKUP_DIR}"
